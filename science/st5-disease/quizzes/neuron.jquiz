% jquiz Parts of a neuron
% multichoice
text: Which part of a neuron is this?
image: neuron/cell_body.png
@answer
text: Cell body
correct: true
@answer
text: Axon
correct: false
@answer
text: Axon terminals
correct: false
@answer
text: Dendrites
correct: false
@answer
text: Myelin sheath
correct: false
@answer
text: Synaptic knob
correct: false


